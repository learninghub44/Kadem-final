# SERVER
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PAYSTACK (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
# Configure this exact URL as your webhook in the Paystack dashboard:
# https://your-backend.onrender.com/api/payments/callback

# REFERRAL BONUSES (KES)
REFERRAL_REGISTRATION_BONUS=50
REFERRAL_ACTIVATION_BONUS=100
REFERRAL_PACKAGE_BONUS=150

# FRONTEND URL (for CORS)
FRONTEND_URL=https://your-site.pages.dev
