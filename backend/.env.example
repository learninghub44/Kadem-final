# SERVER
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# INTASEND (https://app.intasend.com/account/api-keys/)
INTASEND_PUBLISHABLE_KEY=ISPubKey_live_xxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_live_xxxxxxxx
INTASEND_CALLBACK_URL=https://your-backend.onrender.com/api/payments/callback

# REFERRAL BONUSES (KES)
REFERRAL_ACTIVATION_BONUS=100
REFERRAL_PACKAGE_BONUS=150

# FRONTEND URL (for CORS)
FRONTEND_URL=https://your-site.pages.dev
