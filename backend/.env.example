# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PayHero (use Authorization header method)
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2/
PAYHERO_AUTHORIZATION=Basic YOUR_BASE64_TOKEN
PAYHERO_CHANNEL_ID=1234
PAYHERO_CALLBACK_URL=https://your-render-backend.onrender.com/api/payments/callback
PAYHERO_PROVIDER=m-pesa
PAYHERO_CURRENCY=KES

# Frontend URL (for CORS)
FRONTEND_URL=https://your-site.pages.dev

# Referral Bonuses (KES)
REFERRAL_REGISTRATION_BONUS=50
REFERRAL_ACTIVATION_BONUS=100
REFERRAL_PACKAGE_BONUS=150
