# SERVER
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PAYHERO (https://app.payhero.co.ke)
PAYHERO_BASIC_AUTH=Basic_xxxxxxxx
PAYHERO_CHANNEL_ID=your_channel_id
# Set this to the bare callback URL only — the server automatically
# appends ?secret=... using PAYHERO_WEBHOOK_SECRET below. Do not add
# your own query string here.
PAYHERO_CALLBACK_URL=https://your-backend.onrender.com/api/payments/callback
# REQUIRED. PayHero can't sign or add headers to its webhook, so this
# secret (embedded in the callback URL) is the only way to verify a
# callback actually came from a payment you initiated. Generate a long
# random value — the server will refuse to start without this set.
PAYHERO_WEBHOOK_SECRET=replace_with_a_long_random_secret

# REFERRAL BONUSES (KES)
REFERRAL_REGISTRATION_BONUS=50
REFERRAL_ACTIVATION_BONUS=100
REFERRAL_PACKAGE_BONUS=150

# FRONTEND URL (for CORS)
FRONTEND_URL=https://your-site.pages.dev
