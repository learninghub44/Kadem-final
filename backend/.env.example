# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PayHero
PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_USERNAME=your_payhero_username
PAYHERO_PASSWORD=your_payhero_password
PAYHERO_CHANNEL_ID=your_channel_id
PAYHERO_CALLBACK_URL=https://your-render-backend.onrender.com/api/payments/callback

# Frontend URL (for CORS)
FRONTEND_URL=https://your-site.pages.dev

# Referral Bonuses (KES)
REFERRAL_REGISTRATION_BONUS=50
REFERRAL_ACTIVATION_BONUS=100
REFERRAL_PACKAGE_BONUS=150
