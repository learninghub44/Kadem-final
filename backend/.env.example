# SERVER
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PAYHERO
# HOW TO GENERATE PAYHERO_AUTHORIZATION:
#   1. Go to https://app.payhero.co.ke → Settings → API
#   2. Copy your API Username and API Password
#   3. Run in Node.js: Buffer.from('username:password').toString('base64')
#   4. Set below as: Basic <that_base64_string>
PAYHERO_AUTHORIZATION=Basic PASTE_YOUR_BASE64_HERE
PAYHERO_CHANNEL_ID=YOUR_CHANNEL_ID_NUMBER
PAYHERO_CALLBACK_URL=https://your-backend.onrender.com/api/payments/callback

# REFERRAL BONUSES (KES)
REFERRAL_ACTIVATION_BONUS=100
REFERRAL_PACKAGE_BONUS=150

# FRONTEND URL (for CORS)
FRONTEND_URL=https://your-site.pages.dev
