# SERVER
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PAYHERO (https://app.payhero.co.ke)
PAYHERO_BASIC_AUTH=Basic_xxxxxxxx
PAYHERO_CHANNEL_ID=your_channel_id
PAYHERO_CALLBACK_URL=https://your-backend.onrender.com/api/payments/callback
# Optional extra safety check on the callback route (not part of PayHero's
# own protocol — PayHero doesn't sign webhooks). Leave unset to skip the check.
PAYHERO_WEBHOOK_SECRET=

# REFERRAL BONUSES (KES)
REFERRAL_REGISTRATION_BONUS=50
REFERRAL_ACTIVATION_BONUS=100
REFERRAL_PACKAGE_BONUS=150

# FRONTEND URL (for CORS)
FRONTEND_URL=https://your-site.pages.dev
